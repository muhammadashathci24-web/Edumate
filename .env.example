# ========================================================
# EduMate Environment Configuration
# ========================================================
# NOTE: Do NOT commit secrets or service account keys!
# Copy this file to .env.local (or .env) for development.

# --- Client-Side Firebase Configuration (Browser Safe) ---
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHerePlaceholder12345
VITE_FIREBASE_AUTH_DOMAIN=edumate-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=edumate-demo
VITE_FIREBASE_STORAGE_BUCKET=edumate-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: set to true to connect client to local Firebase Emulator
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080

# --- Server-Side Firebase Admin Configuration (Backend Only) ---
# Port for the Node.js Admin SDK backend server
PORT=5000

# Path to the Firebase service account JSON key file (Keep this file private!)
# e.g., ./service-account-key.json or leave empty when running in Firebase Emulator mode
FIREBASE_SERVICE_ACCOUNT_PATH=

# In emulator / local development mode, this simulates Admin SDK operations securely
USE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
