rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthenticated() && getUserDoc().status == 'active';
    }

    function isAdmin() {
      return isActive() && getUserDoc().role == 'admin';
    }

    function isFaculty() {
      return isActive() && getUserDoc().role == 'faculty';
    }

    function isStudent() {
      return isActive() && getUserDoc().role == 'student';
    }

    // Check if faculty is assigned to a specific dept/year/section
    function facultyAssigned(dept, yr, sec) {
      let faculty = get(/databases/$(database)/documents/faculty/$(request.auth.uid)).data;
      return isFaculty() && (
        faculty.assignedClasses.hasAny([
          { "department": dept, "year": yr, "section": sec }
        ])
      );
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection
    // Users can read their own user record; admins can read all; only admin or server can write
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // 2. Students Collection (keyed by normalized USN)
    match /students/{usn} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isStudent() && resource.data.uid == request.auth.uid) ||
        (isFaculty() && facultyAssigned(resource.data.department, resource.data.year, resource.data.section))
      );
      // Students can NEVER edit their own records, USN, role, etc.
      allow create, update, delete: if isAdmin();
    }

    // 3. Faculty Collection (keyed by faculty UID)
    match /faculty/{facultyId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == facultyId
      );
      allow create, update, delete: if isAdmin();
    }

    // 4. Assignments Collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isFaculty() && facultyAssigned(resource.data.department, resource.data.year, resource.data.section)) ||
        (isStudent() && 
          getUserDoc().department == resource.data.department &&
          getUserDoc().year == resource.data.year &&
          getUserDoc().section == resource.data.section)
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        facultyAssigned(request.resource.data.department, request.resource.data.year, request.resource.data.section)
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        facultyAssigned(resource.data.department, resource.data.year, resource.data.section)
      );
    }

    // 5. Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isFaculty() && facultyAssigned(resource.data.department, resource.data.year, resource.data.section)) ||
        (isStudent() &&
          getUserDoc().department == resource.data.department &&
          getUserDoc().year == resource.data.year &&
          getUserDoc().section == resource.data.section)
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        facultyAssigned(request.resource.data.department, request.resource.data.year, request.resource.data.section)
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        facultyAssigned(resource.data.department, resource.data.year, resource.data.section)
      );
    }

    // 6. Marks Collection
    match /marks/{markId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isFaculty() && facultyAssigned(resource.data.department, resource.data.year, resource.data.section)) ||
        (isStudent() &&
          getUserDoc().department == resource.data.department &&
          getUserDoc().year == resource.data.year &&
          getUserDoc().section == resource.data.section)
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        facultyAssigned(request.resource.data.department, request.resource.data.year, request.resource.data.section)
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        facultyAssigned(resource.data.department, resource.data.year, resource.data.section)
      );
    }

    // 7. Config Collection (Departments and Sections)
    match /sectionsConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
